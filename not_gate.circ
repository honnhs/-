<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<project source="3.9.0" version="1.0">
  <lib desc="#Wiring" name="0"/>
  <lib desc="#Gates" name="1"/>
  <lib desc="#Base" name="2"/>
  <main name="main"/>
  <options>
    <a name="simlimit" val="1000"/>
    <a name="simrand" val="0"/>
  </options>
  <mappings>
    <tool lib="2" map="Button2" name="Menu Tool"/>
    <tool lib="2" map="Button3" name="Menu Tool"/>
  </mappings>
  <toolbar>
    <tool lib="2" name="Poke Tool"/>
    <tool lib="2" name="Edit Tool"/>
    <tool lib="2" name="Text Tool"/>
    <sep/>
    <tool lib="0" name="Pin"/>
    <tool lib="0" name="Pin"><a name="output" val="true"/></tool>
  </toolbar>
  <circuit name="main">
    <a name="circuit" val="main"/>
    <a name="appearance" val="logisim_evolution"/>
    <comp lib="0" loc="(100,180)" name="Pin">
      <a name="facing" val="east"/>
      <a name="label" val="a"/>
      <a name="labelloc" val="west"/>
    </comp>
    <comp loc="(400,180)" name="not_gate">
      <a name="facing" val="east"/>
      <a name="appearance" val="logisim_evolution"/>
    </comp>
    <comp lib="0" loc="(480,180)" name="Pin">
      <a name="facing" val="west"/>
      <a name="output" val="true"/>
      <a name="label" val="y"/>
      <a name="labelloc" val="east"/>
    </comp>
    <wire from="(100,180)" to="(180,180)"/>
    <wire from="(400,180)" to="(480,180)"/>
  </circuit>
  <vhdl name="not_gate"><![CDATA[library ieee;
use ieee.std_logic_1164.all;

entity not_gate is
    port (
        a : in  std_logic;
        y : out std_logic
    );
end not_gate;

architecture rtl of not_gate is
begin
    y <= not a;
end rtl;
]]></vhdl>
</project>
